# ============================================================
# Mathumi Bridal — Next.js Frontend .htaccess for cPanel
# ============================================================
# This file is used by Apache to proxy requests to the
# Next.js Node.js application running on a local port.
# Set this up under cPanel → Setup Node.js App.
# ============================================================

Options -MultiViews
RewriteEngine On

# --- Force HTTPS ---
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Remove trailing slash (except root) ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# --- Proxy all requests to Next.js Node app (port 3000) ---
# Replace 3000 with the port assigned by cPanel Node.js App setup
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]

# Proxy pass-through headers
ProxyPassReverse / http://127.0.0.1:3000/

# --- Security Headers ---
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# --- Static Asset Caching ---
<FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|eot|css|js)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# --- Gzip Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json
</IfModule>
